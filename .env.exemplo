# Copie para .env e preencha VOCÊ MESMO, num editor de texto. Nunca cole o token num chat.
# O .env está no .gitignore e não vai para o GitHub.

# Conta profissional do Instagram (criador ou empresa) + token gerado no app da Meta (SETUP.md, parte 2)
IG_USER_ID=000000000000000
IG_ACCESS_TOKEN=cole-o-token-aqui
# Token do "API setup with Unified login" começa com EAA e usa graph.facebook.com
IG_API_HOST=graph.facebook.com
IG_API_VERSION=v23.0

# O repositório PÚBLICO que serve os vídeos (GitHub Pages), clonado nesta máquina (SETUP.md, parte 3)
LINKS_DIR=/caminho/para/links-reels
LINKS_URL=https://SEU-USUARIO.github.io/links-reels
